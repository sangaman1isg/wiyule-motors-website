# Copy this file to .deploy.env and fill in your real FTP details.
# .deploy.env is gitignored — it is NEVER committed.
#
# Get these from DirectAdmin → FTP Management (create/view an FTP account).

FTP_HOST=wiyulemotors.co.mw
FTP_USER=your_ftp_username
FTP_PASS=your_ftp_password

# Absolute path to the web root on the server. For DirectAdmin this is
# usually one of:
#   /domains/wiyulemotors.co.mw/public_html
#   public_html          (if the FTP account already lands in the domain folder)
REMOTE_DIR=/domains/wiyulemotors.co.mw/public_html
